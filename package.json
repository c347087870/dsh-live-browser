{
  "name": "dsh-live-browser",
  "version": "0.3.0",
  "description": "让 agent 操作 DSH 自带的侧边栏浏览器：真实 webview 渲染，注入命令层，可点击、输入、读取和滚动用户眼前那张页面。",
  "type": "module",
  "license": "MIT",
  "author": "c347087870",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c347087870/dsh-live-browser.git"
  },
  "homepage": "https://github.com/c347087870/dsh-live-browser#readme",
  "bugs": {
    "url": "https://github.com/c347087870/dsh-live-browser/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "browser",
    "browser-automation",
    "webview",
    "agent-tools"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/test-all.mjs",
    "strip-bom": "node scripts/strip-bom.mjs"
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-host-webserver": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "devDependencies": {
    "jsdom": "^30.1.3"
  },
  "dsh": {
    "plugin": true,
    "kind": "server",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
